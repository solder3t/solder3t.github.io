#!/bin/bash
set -euo pipefail

echo "📦 Bootstrapping antigravity-installer utility..."
WORKDIR="$(mktemp -d)"
cd "$WORKDIR" || exit 1

# Download and extract the latest main branch of antigravity-installer
curl -fsSL "https://github.com/solder3t/antigravity-installer/archive/refs/heads/main.tar.gz" | tar -xz
cd antigravity-installer-main || exit 1

echo "▶ Launching Installer..."
# Execute the installation script, reconnecting stdin to the console 
# so the interactive whiptail TUI works perfectly even when piped from curl.
exec bash ./install.sh "$@" < /dev/tty
