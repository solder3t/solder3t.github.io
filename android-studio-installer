#!/bin/bash
set -euo pipefail

echo "📦 Bootstrapping Android Studio installer..."
WORKDIR="$(mktemp -d)"
cd "$WORKDIR" || exit 1

# Download and extract the latest main branch of android-studio-installer
curl -fsSL "https://github.com/solder3t/android-studio-installer/archive/refs/heads/main.tar.gz" | tar -xz
cd android-studio-installer-main || exit 1

echo "▶ Launching Installer..."
# Execute the installation script, reconnecting stdin to the console 
# so interactive prompts and selections work perfectly even when piped from curl.
exec bash ./install.sh "$@" < /dev/tty
